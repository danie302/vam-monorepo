# Base URL of the VAM API (vam/). The API trusts http://localhost:3001 by
# default; on another origin, add it to the API's WEB_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Where auth goes: "http" (default) uses the API above; "memory" keeps
# accounts in the browser tab, lost on reload, to work without the backend.
NEXT_PUBLIC_AUTH_ADAPTER=http

# Who answers the chat: "http" (default) streams from the API's LLM;
# "placeholder" streams a canned answer, no API or OpenAI key needed.
NEXT_PUBLIC_CHAT_ADAPTER=http
